# .env.example - copy this file to ".env" and fill in your own values.
# .env holds secrets and is in .gitignore - NEVER commit it. This example file is safe to commit.

# ---------------------------------------------------------------- Admin
# Password for the /admin control room. Choose your own.
ADMIN_PASSWORD=change-me

# ---------------------------------------------------------------- M-Pesa (Daraja sandbox)
# true  = real STK prompt to the phone (sandbox takes REAL money from a real number,
#         normally reversed by Safaricom - keep MPESA_SANDBOX_AMOUNT=1)
# false = simulator: instant, no phone prompt, no money moves (use for everyday testing)
MPESA_ENABLED=false

# From your Daraja sandbox app (developer.safaricom.co.ke -> My Apps -> your app)
MPESA_CONSUMER_KEY=paste-your-consumer-key-here
MPESA_CONSUMER_SECRET=paste-your-consumer-secret-here

# Sandbox paybill and its test passkey (from the M-Pesa Express simulator page)
MPESA_SHORTCODE=174379
MPESA_PASSKEY=paste-the-sandbox-passkey-here

# Safaricom's sandbox server
MPESA_BASE_URL=https://sandbox.safaricom.co.ke

# Where Safaricom would post results. We check results by polling instead,
# so a placeholder is fine for local development.
MPESA_CALLBACK_URL=https://example.com/mpesa/callback

# The phone prompt asks for this amount (KES) instead of the real fee;
# the system still records the real fee as paid. Empty = real fee.
MPESA_SANDBOX_AMOUNT=1
